	"item": [
		{
			"name": "IsValidISBN13 - valid",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Беремо відповідь як текст (XML)\r",
							"const body = pm.response.text();\r",
							"\r",
							"// 1) Status code\r",
							"pm.test(\"Status code is 200\", function () {\r",
							"  pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// 2) Body не порожній\r",
							"pm.test(\"Response body is not empty\", function () {\r",
							"  pm.expect(body).to.not.be.empty;\r",
							"});\r",
							"\r",
							"// 3) Content-Type існує і схожий на XML/SOAP\r",
							"pm.test(\"Header Content-Type contains xml\", function () {\r",
							"  const ct = pm.response.headers.get(\"Content-Type\");\r",
							"  pm.expect(ct).to.exist;\r",
							"  pm.expect(ct.toLowerCase()).to.include(\"xml\");\r",
							"});\r",
							"\r",
							"// 4) Є SOAP Envelope\r",
							"pm.test(\"Body contains SOAP Envelope\", function () {\r",
							"  pm.expect(body).to.include(\"<soap:Envelope\");\r",
							"});\r",
							"\r",
							"// 5) Є SOAP Body\r",
							"pm.test(\"Body contains SOAP Body\", function () {\r",
							"  pm.expect(body).to.include(\"<soap:Body\");\r",
							"});\r",
							"\r",
							"// 6) Є відповідь саме від методу IsValidISBN13\r",
							"pm.test(\"Contains IsValidISBN13Response\", function () {\r",
							"  pm.expect(body).to.include(\"IsValidISBN13Response\");\r",
							"});\r",
							"\r",
							"// 7) Є тег Result\r",
							"pm.test(\"Contains IsValidISBN13Result\", function () {\r",
							"  pm.expect(body).to.include(\"IsValidISBN13Result\");\r",
							"});\r",
							"\r",
							"// 8) Результат true (для валідного ISBN)\r",
							"pm.test(\"Result is true\", function () {\r",
							"  pm.expect(body).to.include(\">true<\");\r",
							"});\r",
							"\r",
							"// 9) Немає SOAP Fault\r",
							"pm.test(\"No SOAP Fault\", function () {\r",
							"  pm.expect(body).to.not.include(\"Fault\");\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
